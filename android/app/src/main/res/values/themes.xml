<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AfriLearn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/adire_700</item>
        <item name="android:colorPrimary">@color/adire_700</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Shown while the app opens: the logo on brand indigo. -->
    <style name="Theme.AfriLearn.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/adire_700</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.AfriLearn</item>
    </style>
</resources>
