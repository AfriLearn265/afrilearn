# Copy to .env.local for local development. Never commit real secret keys.

# Supabase project (Project Settings -> API). These two are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public address of the site, used in email links (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Server-only secrets (set in Vercel -> Settings -> Environment Variables) ----
# Needed for parent-created child accounts and Paystack payment confirmation.
SUPABASE_SECRET_KEY=

# AI learning companion (optional). Without a key the companion shows a clear
# "not configured" message instead of pretending to work.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Paystack (test keys during the pilot).
PAYSTACK_SECRET_KEY=

# Live classes through Jitsi as a Service (8x8). Without these, live classes
# fall back to the public Jitsi server, which cuts embedded calls at 5 minutes.
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY=
